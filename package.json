{
  "name": "monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.7.0",
  "scripts": {
    "check:non-production-db": "node scripts/assert-non-production-supabase.mjs",
    "check:supabase-reachable": "node scripts/assert-supabase-reachable.mjs",
    "dev": "turbo run dev",
    "dev:local": "bash scripts/dev.sh",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "rebuild": "turbo run rebuild"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "turbo": "^2.10.7",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "axios": "^1.13.2"
  }
}
