{
  "name": "@repo/design-tokens",
  "version": "0.0.1",
  "private": true,
  "description": "page0127 디자인 토큰 — Figma Variables 와 왕복하는 단일 출처",
  "type": "module",
  "exports": {
    "./tokens.css": "./dist/tokens.css",
    "./css-vars": "./src/css-vars.ts"
  },
  "scripts": {
    "build": "node build.mjs",
    "update-baseline": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/update-baseline.ts",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "rebuild": "npm run clean && npm run build"
  },
  "files": ["dist", "tokens", "src"],
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "eslint": "^9.39.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "style-dictionary": "^5.0.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
