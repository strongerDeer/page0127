# ============================================
# 로컬 개발 환경변수 템플릿
# 사용법: 이 파일을 .env.local로 복사한 뒤 아래 값들을 실제 값으로 채우세요.
#   cp .env.example .env.local
#
# ⚠️ NEXT_PUBLIC_ 접두사가 붙은 순간 Next.js가 해당 값을
#    클라이언트 번들에 그대로 포함시킵니다. 비밀값에는 절대 붙이지 마세요.
# ============================================

# GitHub & supabase-----------------------------------------------------------------------
# Project Settings > API 에서 확인 (공개 — 클라이언트에서 사용)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
# Service Role Key — RLS(행 단위 보안)를 전부 우회하는 관리자 키.
# 서버 전용 코드(admin.ts 등)에서만 사용. 절대 브라우저로 노출되면 안 됨.
SUPABASE_SERVICE_ROLE_KEY=

# CI/Preview 안전 검사에서 비교할 운영 프로젝트 URL.
# URL 자체는 공개 정보이며, Preview/CI의 NEXT_PUBLIC_SUPABASE_URL과 달라야 함.
PRODUCTION_SUPABASE_URL=

#GitHub Actions-----------------------------------------------------------------------
CHROMATIC_PROJECT_TOKEN=
#Google
CRUX_API_KEY=
PRODUCTION_SUPABASE_SERVICE_ROLE_KEY=
QUALITY_TARGET_URL=

# vercel-----------------------------------------------------------------------
# OAuth 리다이렉트 등에 사용. 비워두면 location.origin으로 대체됨 (선택)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# --- 관리자 ---
# 관리자 이메일 화이트리스트 (쉼표 구분). /admin 접근 허용 대상.
ADMIN_EMAILS=you@example.com

# --- Cron / 배포 ---
# Vercel Cron 요청 인증용 시크릿. 운영/Preview에서는 필수이며, 누락 시 cron API가 실패함
CRON_SECRET=

## 외부 API (서버 전용) ---
### YES24 Open API 키 (도서 검색·상세. YES24 회원이면 심사 없이 즉시 발급)
YES24_API_KEY=

### Google Analytics 4 측정 ID (예: G-XXXXXXXXXX). 비워두면 GA 스크립트 자체가 로드되지 않음
NEXT_PUBLIC_GA_ID=

### 어드민 유입분석(/admin/analytics)이 GA4·Search Console 숫자를 읽는 데 쓰는 서비스 계정.
### 비워두면 화면이 "어떤 변수가 빠졌는지"만 보여 준다(앱의 다른 기능에는 영향 없음).
# GA 관리 > 속성 설정 > 속성 세부정보의 "속성 ID"(숫자만. G-로 시작하는 측정 ID 가 아니다)
GA4_PROPERTY_ID=
# 서비스 계정 JSON 키의 client_email
GOOGLE_SA_CLIENT_EMAIL=
# 서비스 계정 JSON 키의 private_key. 한 줄로 붙여 넣어도 된다(코드가 글자 \n 을 줄바꿈으로 되돌림)
GOOGLE_SA_PRIVATE_KEY=
# Search Console 속성 이름 그대로 — 'https://page0127.com/' 또는 'sc-domain:page0127.com'
SEARCH_CONSOLE_SITE_URL=

### 네이버 서치어드바이저 소유권 확인 코드
### searchadvisor.naver.com > 웹마스터도구 > 사이트 등록 > HTML 태그의 content 값만 넣는다.
### 비워두면 메타 태그가 나가지 않는다(구글 것은 코드에 박혀 있다).
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=

### chatGPT ---
OPENAI_API_KEY=

### Sentry ---
# DSN은 브라우저 오류 전송 대상 식별자이므로 공개 가능. 환경별 프로젝트 값을 사용
NEXT_PUBLIC_SENTRY_DSN=
# 소스맵 업로드용 빌드 시크릿. Vercel에만 저장하고 브라우저·Git에 노출 금지
SENTRY_AUTH_TOKEN=
# 어드민 에러 탭이 이슈를 읽는 데 쓰는 개인 토큰(sntryu_로 시작).
# 스코프는 event:read, project:read 두 개만. 소스맵용 SENTRY_AUTH_TOKEN과는 별개다.
# 발급: https://sentry.io/settings/account/api/auth-tokens/
SENTRY_ISSUES_TOKEN=



### 카카오톡 에러 알림 ---
# Sentry 알림 규칙 → /api/alerts/sentry → 운영자 카톡("나에게 보내기"). 런북 6장.
# 로그인용 카카오 앱과 **다른** 알림 전용 앱의 키다(로그인 동의 화면을 건드리지 않으려고).
# 카카오 콘솔 > 앱 > 앱 키 > REST API 키 / 보안 > Client Secret
KAKAO_ALERT_REST_API_KEY=
KAKAO_ALERT_CLIENT_SECRET=
# Sentry > Settings > Developer Settings > Custom Integrations > (Internal) > Client Secret.
# 웹훅 서명(Sentry-Hook-Signature) 검증용. 없으면 웹훅이 500 으로 닫힌다(fail-closed).
SENTRY_ALERT_CLIENT_SECRET=
